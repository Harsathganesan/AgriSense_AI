{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "echo 'AgriSense FastAPI backend ready'",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?path=/api/:match*"
    },
    {
      "source": "/:match*",
      "destination": "/api/index.py?path=/:match*"
    }
  ]
}

