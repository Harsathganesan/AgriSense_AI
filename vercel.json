{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{ml-training/**,frontend/**,backend/app/models/*.keras,backend/app/models/*.tflite,backend/tests/**,*.md,*.log}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?path=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?path=/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
