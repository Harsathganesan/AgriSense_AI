{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?path=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?path=/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
