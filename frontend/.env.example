# AgriSense AI Frontend Configuration Template
# -------------------------------------------------------------
# Copy this file to .env and adjust values for your environment:
# cp .env.example .env

# Frontend Vite Dev Server Port
VITE_PORT=5173

# Backend API Configuration
# - In development: Leave blank so requests use Vite dev proxy (/api -> backend)
# - On Vercel: Leave blank so requests use same-origin /api rewrite
# - Only set this if your backend is hosted on a completely separate domain
VITE_API_BASE_URL=
VITE_BACKEND_PORT=8000
VITE_BACKEND_HOST=127.0.0.1

# Application Identity & Defaults
VITE_APP_NAME="AgriSense AI"
VITE_APP_TAGLINE="Smart Crop Rotation & Soil Health Decision Platform"
VITE_DEFAULT_LANGUAGE=en
VITE_DEFAULT_DISTRICT=Pudukkottai
VITE_DEFAULT_STATE="Tamil Nadu"
VITE_DEFAULT_COUNTRY=India

# NASA Earth Observation & AI Configuration
VITE_NASA_POWER_API_BASE=https://power.larc.nasa.gov/api/temporal/daily/point
VITE_GEMINI_MODEL=gemini-2.5-flash
